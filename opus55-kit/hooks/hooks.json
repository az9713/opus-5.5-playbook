{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/opus55.py\" prompt || python \"${CLAUDE_PLUGIN_ROOT}/hooks/opus55.py\" prompt",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/opus55.py\" stop || python \"${CLAUDE_PLUGIN_ROOT}/hooks/opus55.py\" stop",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
